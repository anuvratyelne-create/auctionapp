# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# JWT Secret (IMPORTANT: Use a strong random string, at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Server Configuration
PORT=3001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Auto-Cleanup Settings
# Number of days to keep abandoned tournaments (default: 90)
TOURNAMENT_RETENTION_DAYS=90
# Set to 'true' to disable auto-cleanup entirely
DISABLE_AUTO_CLEANUP=false

# Admin JWT Secret (optional, falls back to JWT_SECRET)
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

# Demo Mode Settings
# Set to 'true' to disable demo login (recommended for production)
DISABLE_DEMO=false

# Socket/Memory Configuration
# Maximum auction states to keep in memory (default: 50)
MAX_AUCTION_STATES=50
# Maximum bid history entries per auction (default: 100)
MAX_BID_HISTORY=100
# Maximum chat messages per tournament (default: 100)
MAX_CHAT_MESSAGES=100

# Rate Limiting
# Rate limit window in milliseconds (default: 1000 = 1 second)
RATE_LIMIT_WINDOW_MS=1000
# Maximum events per rate limit window (default: 10)
RATE_LIMIT_MAX_EVENTS=10

# State Cleanup
# Time-to-live for inactive states in milliseconds (default: 1800000 = 30 minutes)
STATE_TTL_MS=1800000
# Cleanup interval in milliseconds (default: 600000 = 10 minutes)
CLEANUP_INTERVAL_MS=600000

# CSRF Protection (optional, falls back to JWT_SECRET)
CSRF_SECRET=your_csrf_secret_here

# Logging Configuration
# Directory for log files (default: server/logs)
LOG_DIR=./logs
# Set to 'true' to enable file logging in development
ENABLE_FILE_LOGS=false
